# ---------------------------------------------------------------------------
# research-crew configuration
# Copy this file to `.env` and fill in real values. NEVER commit your .env.
# ---------------------------------------------------------------------------

# --- Required ---

# OpenAI API key used by every agent's LLM.
OPENAI_API_KEY=sk-your-openai-key-here

# Tavily API key used by the Web Researcher's search tool.
# Get one (free tier available) at https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-key-here

# --- Optional (sensible defaults shown) ---

# Chat model the crew runs on. GPT-4o recommended for quality.
OPENAI_MODEL=gpt-4o

# Sampling temperature for the agents (0.0-1.0). Lower = more deterministic.
LLM_TEMPERATURE=0.2

# Max Tavily results fetched per sub-question.
SEARCH_MAX_RESULTS=5

# Directory where reports and traces are written.
OUTPUT_DIR=outputs

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# FastAPI bind address (used by `uvicorn research_crew.api.app:app`).
API_HOST=0.0.0.0
API_PORT=8000
